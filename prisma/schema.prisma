generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  COMUM
  ADMIN
}

enum Sexo {
  M
  F
}

enum Porte {
  PEQUENO
  MEDIO
  GRANDE
}

enum StatusAnimal {
  DISPONIVEL
  EM_PROCESSO
  ADOTADO
}

enum StatusPedido {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

model Usuario {
  id           Int      @id @default(autoincrement()) @map("id_usuario")
  nome         String   @map("nome_usuario") @db.VarChar(100)
  email        String   @unique @map("email_usuario") @db.VarChar(150)
  senha        String   @map("senha_usuario") @db.VarChar(255)
  perfil       Perfil   @default(COMUM) @map("perfil_usuario")
  cep          String   @map("cep_usuario") @db.Char(8)
  logradouro   String?  @map("logradouro_usuario") @db.VarChar(150)
  bairro       String?  @map("bairro_usuario") @db.VarChar(100)
  cidade       String   @map("cidade_usuario") @db.VarChar(100)
  uf           String   @map("uf_usuario") @db.Char(2)
  criadoEm     DateTime @default(now()) @map("criado_em")
  senhaAlteradaEm DateTime? @map("senha_alterada_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  animais Animal[]
  pedidos PedidoAdocao[]
  tokensRecuperacao TokenRecuperacaoSenha[]

  @@map("usuario")
}

model TokenRecuperacaoSenha {
  id        Int       @id @default(autoincrement()) @map("id_token")
  usuarioId Int       @map("id_usuario")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("token_recuperacao_senha")
}

model Animal {
  id             Int          @id @default(autoincrement()) @map("id_animal")
  usuarioId      Int          @map("id_usuario")
  nome           String       @map("nome_animal") @db.VarChar(100)
  sexo           Sexo         @map("sexo_animal")
  dataNascimento DateTime?    @map("data_nascimento") @db.Date
  castrado       Boolean      @default(false)
  vacinado       Boolean      @default(false)
  descricao      String?      @db.Text
  status         StatusAnimal @default(DISPONIVEL) @map("status_animal")
  criadoEm       DateTime     @default(now()) @map("criado_em")
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em")

  dono     Usuario        @relation(fields: [usuarioId], references: [id])
  cachorro Cachorro?
  gato     Gato?
  pedidos  PedidoAdocao[]

  @@index([status])
  @@map("animal")
}

model Cachorro {
  animalId            Int     @id @map("id_animal")
  porte               Porte   @map("porte_cachorro")
  conviveComCachorros Boolean @default(false) @map("convive_com_cachorros")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("cachorro")
}

model Gato {
  animalId        Int     @id @map("id_animal")
  testadoFivFelv  Boolean @default(false) @map("testado_fiv_felv")
  conviveComGatos Boolean @default(false) @map("convive_com_gatos")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("gato")
}

model PedidoAdocao {
  id           Int          @id @default(autoincrement()) @map("id_pedido")
  usuarioId    Int          @map("id_usuario")
  animalId     Int          @map("id_animal")
  status       StatusPedido @default(PENDENTE) @map("status_pedido")
  motivo       String       @map("motivo_adocao") @db.Text
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  adotante Usuario @relation(fields: [usuarioId], references: [id])
  animal   Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, status])
  @@map("pedido_adocao")
}