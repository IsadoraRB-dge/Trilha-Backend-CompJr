# Banco de dados (usado pelo docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=adocao_dev
POSTGRES_DB=adocao

# Porta do PostgreSQL exposta no computador.
# Uso 5433 para não conflitar com um PostgreSQL já instalado na máquina.
POSTGRES_PORT=5433

# API
API_PORT=3000

# Uso apenas ao rodar o Prisma fora do Docker (ex.: npx prisma migrate dev).
# Dentro do Docker, a API recebe a URL definida no docker-compose.yml.
DATABASE_URL="postgresql://admin:adocao_dev@localhost:5433/adocao?schema=public"