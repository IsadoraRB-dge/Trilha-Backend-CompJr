# Banco de dados (usado pelo docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=adocao_dev
POSTGRES_DB=adocao

# Porta do PostgreSQL exposta no computador.
# Uso 5433 para não conflitar com um PostgreSQL já instalado na máquina.
POSTGRES_PORT=5433

# API
API_PORT=3000

# Uso apenas ao rodar o Prisma fora do Docker (ex.: npx prisma migrate dev).
# Dentro do Docker, a API recebe a URL definida no docker-compose.yml.
DATABASE_URL="postgresql://admin:adocao_dev@localhost:5433/adocao?schema=public"


# Autenticação (JWT)

JWT_SECRET=essachavesupersecretaealtamentedificilamominhagatinhaelizabeth
JWT_EXPIRES_IN=1h

# Recuperação de senha: validade do código em minutos
RESET_TOKEN_EXPIRES_MINUTES=15

# E-mail. Os e-mails enviados aparecem em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Adoção de Animais <nao-responda@adocao.local>"
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Administrador criado automaticamente ao iniciar a API (se ainda não existir)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@adocao.local
ADMIN_PASSWORD=Admin@12345